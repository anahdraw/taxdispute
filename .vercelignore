# Local corpora, generated artifacts, and runtime state must never be uploaded
# by a local Vercel CLI deployment. Production data is provisioned separately.
data/
uploads/
outputs/
services/lightrag/storage/

# Rendered/manual artifacts are development evidence, not application assets.
docs/render_user_manual/
docs/user_manual_assets/

# Source documents can contain confidential taxpayer or client information.
*.pdf
*.doc
*.docx
*.pptx
*.xlsx
*.zip

# Local secrets and caches.
.env
.env.*
!.env.example
.streamlit/
.vercel/
node_modules/
.next/
out/
.turbo/
tsconfig.tsbuildinfo
render_llm_architecture/
__pycache__/
*.pyc
*.sqlite
*.sqlite3
*.db

# Development-only test and evaluation sources are retained in Git but are
# excluded from the serverless upload bundle.
test_*
tests/
