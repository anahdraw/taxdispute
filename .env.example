# Copy this file to .env for local development.
# Do not commit real secrets.

# OpenAI: required for LLM extraction, analysis, and smart chatbot.
OPENAI_API_KEY=sk-isi-api-key-anda-di-sini
TDP_LLM_MODEL=gpt-5.4-mini
TDP_REASONING_EFFORT=low
TDP_TEXT_VERBOSITY=low

# Tavily: optional external research for TP Local File and regulatory analysis.
# Create a key in Tavily, then add the same variables to Vercel Environment Variables.
TAVILY_API_KEY=tvly-isi-api-key-anda-di-sini
TAVILY_PROJECT_ID=alpha-ai-jurist

# Session signing secret for server-side login cookies.
# Use a long random value in Vercel production.
TDP_AUTH_SECRET=replace-with-a-long-random-secret

# Vercel Blob: required for PDF uploads and PDF viewer links.
# TP Local File uploads require a private Blob store; public Blob URLs are not supported.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Durable TP agent worker. Use a long random value; Vercel Cron sends it as a Bearer token.
CRON_SECRET=replace-with-a-long-random-cron-secret
# Confidential verification/drafting defaults to on-prem/manual. Set allow_openai
# only after the client engagement, DPA, retention, and professional approvals permit it.
TDP_CONFIDENTIAL_LLM_POLICY=onprem_only
# Optional local worker script settings.
TP_AGENT_WORKER_URL=http://127.0.0.1:3000/api/internal/tp-agent-worker
TP_AGENT_WORKER_MAX_RUNS=20

# Postgres/Neon: required for saved decisions, reports, regulations, users, and logs.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Optional fallback name used by some Vercel/Postgres integrations.
POSTGRES_URL=postgres://user:password@host/db?sslmode=require

# Search corpus access is local by default, even when DATABASE_URL is present.
# Use `database` only after the existing decision/regulation schemas have been
# migrated separately; search itself runs SELECT queries and never migrates.
TDP_SEARCH_STORE=local

# Persistent candidate index. `prefer` uses a fresh local index and falls back
# safely; `required` returns 503 when the index is missing/stale; default `off`.
TDP_PERSISTENT_SEARCH=off
TDP_PERSISTENT_SEARCH_ROOT=data/local-search-index

# Optional local regulation snapshot generated from Anahdraw/peraturan-pipeline.
# Leave blank to use the built-in seed cards. The snapshot is read-only and is
# never sent to the client or used to mutate a database.
TDP_REGULATION_PIPELINE_DB=tools/peraturan-pipeline/data/peraturan.db
TDP_LOCAL_REGULATION_SNAPSHOT=data/regulation-pipeline-import/next-regulations.jsonl.gz
# Optional book ground-truth projection generated from the supplied Buku Praktis Pajak PDF.
TDP_BOOK_GROUND_TRUTH_SNAPSHOT=data/reference-knowledge/buku-praktis-pajak-records.jsonl.gz
# Local development path used by /api/reference-pdfs/buku-praktis-pajak-2025.
TDP_BOOK_PDF_PATH=data/reference-knowledge/Buku-Saku-Pajak-Cover-revisi-2.pdf
# Compact, deployable official-knowledge registry and searchable Coretax page index.
TDP_OFFICIAL_KNOWLEDGE_SNAPSHOT=content/official-knowledge/official-knowledge.json
TDP_OFFICIAL_KNOWLEDGE_CHUNKS=content/official-knowledge/coretax-chunks.json

# Tenant/client/matter metadata. Local development defaults to durable JSON so
# a cloud DATABASE_URL in .env.local is never touched by the local workspace.
TDP_WORKSPACE_STORE=local
# Optional test/development overrides (defaults are data/local-workspace and data/private-storage).
TDP_LOCAL_WORKSPACE_ROOT=
# Keep the runtime private root outside the project directory for standalone/Docker deployments.
# Example: /srv/aa-jurist-private (local development may leave this blank).
TDP_PRIVATE_STORAGE_ROOT=
TDP_PRIVATE_UPLOAD_MAX_MB=50
TDP_DEFAULT_TENANT_ID=tenant-default
TDP_DEFAULT_TENANT_NAME=AA Jurist Local Workspace
# Optional. When omitted, auto-enrollment is enabled only for non-production
# local-store development. Production/database mode defaults to disabled.
TDP_DEFAULT_TENANT_AUTO_ENROLL=

# Optional graph-enhanced regulation retrieval through a private LightRAG service.
# Keep baseline in production until the pilot evaluation and security gates pass.
AAJ_RAG_PROVIDER=baseline
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
LIGHTRAG_QUERY_MODE=mix
LIGHTRAG_TOP_K=20
LIGHTRAG_CHUNK_TOP_K=12
LIGHTRAG_TIMEOUT_MS=30000
LIGHTRAG_ENABLE_RERANK=false
# Full-corpus manifest is generated locally. Do not switch AAJ_RAG_PROVIDER
# until an active index manifest reports the exact same count and corpus hash.
TDP_LIGHTRAG_FULL_MANIFEST=outputs/lightrag/full-corpus-manifest.json
TDP_LIGHTRAG_ACTIVE_MANIFEST=outputs/lightrag/active-index.json

# Enterprise object storage selection. Local private storage works on one
# durable host. Vercel Blob remains partial until lifecycle/restore evidence;
# S3-compatible is intentionally a declared gap until its adapter exists.
TDP_OBJECT_STORAGE=local_private
TDP_S3_ENDPOINT=
TDP_S3_BUCKET=
TDP_S3_REGION=

# Metadata-only observability and configurable cost estimates. Prices are not
# hard-coded because provider prices change; enter the contracted rates.
TDP_AI_INPUT_USD_PER_MILLION=0
TDP_AI_OUTPUT_USD_PER_MILLION=0
TDP_MONTHLY_AI_BUDGET_USD=0
TDP_AI_BUDGET_WARN_PERCENT=80
TDP_AI_BUDGET_HARD_LIMIT=false

# Enterprise identity readiness. MFA is fail-closed: enabling it before a
# verified OIDC session supplies an amr=mfa/otp/hwk claim will block login.
TDP_OIDC_ISSUER=
TDP_OIDC_CLIENT_ID=
TDP_OIDC_CLIENT_SECRET=
TDP_MFA_REQUIRED=false

# Retention defaults are dry-run/manual. Destructive sweep stays disabled
# until schedules, legal hold, approval, and backup evidence are approved.
TDP_RETENTION_ENABLED=false
TDP_RETENTION_AUDIT_DAYS=365
TDP_RETENTION_CHAT_DAYS=180
TDP_RETENTION_PRIVATE_FILE_DAYS=365
TDP_RETENTION_BACKUP_DAYS=30
TDP_LEGAL_HOLD_MODE=manual
TDP_RETENTION_DESTRUCTIVE_SWEEP=false
TDP_BACKUP_ROOT=outputs/enterprise-backups
TDP_BACKUP_STATUS_FILE=outputs/enterprise-backups/latest-status.json
