# AA-Jurist LightRAG local prototype. Copy to .env; never commit real keys.

HOST=127.0.0.1
PORT=9621
WORKSPACE=aa_jurist_regulations_v1
WEBUI_TITLE=AA-Jurist Regulation Graph Prototype
WEBUI_DESCRIPTION=LightRAG evaluation workspace for curated Indonesian tax regulations
WORKING_DIR=./rag_storage
INPUT_DIR=./inputs
LOG_DIR=./logs
TIKTOKEN_CACHE_DIR=./tiktoken_cache

# Protect every route except liveness. Generate a long random value locally.
LIGHTRAG_API_KEY=replace-with-a-long-random-api-key
TOKEN_SECRET=replace-with-a-different-long-random-token-secret
WHITELIST_PATHS=/health
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# OpenAI / OpenAI-compatible models. Use the same secret for both key fields.
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=replace-with-openai-api-key
LLM_MODEL=gpt-5.5
KEYWORD_LLM_MODEL=gpt-5.4-nano
QUERY_LLM_MODEL=gpt-5.5
MAX_ASYNC_LLM=2
KEYWORD_MAX_ASYNC_LLM=2
QUERY_MAX_ASYNC_LLM=2
LLM_TIMEOUT=240
OPENAI_LLM_MAX_COMPLETION_TOKENS=9000
OPENAI_LLM_REASONING_EFFORT=low

EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=replace-with-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=false
EMBEDDING_USE_BASE64=true
EMBEDDING_FUNC_MAX_ASYNC=4
EMBEDDING_BATCH_NUM=16

# Domain extraction profile. A change requires reindexing the workspace.
SUMMARY_LANGUAGE=Indonesian
ENTITY_EXTRACTION_USE_JSON=true
PROMPT_DIR=./prompts
ENTITY_TYPE_PROMPT_FILE=aa_jurist_tax.yml
ENABLE_LLM_CACHE_FOR_EXTRACT=true
ENABLE_LLM_CACHE=true
MAX_PARALLEL_INSERT=2
MAX_EXTRACT_INPUT_TOKENS=12000
MAX_EXTRACTION_RECORDS=80
MAX_EXTRACTION_ENTITIES=40

# Deliberately lightweight local persistence. Do not use these backends for
# multi-process or production deployment.
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

RERANK_BINDING=null
TOP_K=20
CHUNK_TOP_K=12
MAX_ENTITY_TOKENS=4000
MAX_RELATION_TOKENS=5000
MAX_TOTAL_TOKENS=16000
KG_CHUNK_PICK_METHOD=VECTOR
